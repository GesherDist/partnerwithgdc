# ============================================================================
# Gesher DB backup - OPTIONAL overrides
#
# You normally do NOT need this file. db-backup.sh reads what it needs from the
# app's own .env (repo root: .env.production.local / .env.local /
# .env.production / .env, or APP_ENV_FILE=...):
#   DIRECT_URL       -> DB host, port, user, password, database
#                       (localhost -> PGSSLMODE=disable, else require)
#   SMTP_USER        -> Postmark server token (when SMTP_HOST is Postmark)
#   SMTP_FROM_EMAIL  -> alert "From"
#   SUPPORT_EMAIL    -> alert "To"
#
# Only to change something, copy to /etc/gesher/db-backup.env on the server
# and uncomment the lines you need. Values here win over the app .env.
#   sudo mkdir -p /etc/gesher
#   sudo cp backup.env.example /etc/gesher/db-backup.env
#   sudo chmod 600 /etc/gesher/db-backup.env
# Never commit a filled copy.
# ============================================================================

# --- Where the app .env is (only if it is not in the repo root) ---
# APP_ENV_FILE=/path/to/partnerwithgdc/.env

# --- Database (only to NOT use DIRECT_URL) ---
# Use port 5432 (Supavisor SESSION mode), never 6543 (transaction mode):
# pg_dump does not work through the transaction pooler.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<tenant-id>
# PGPASSWORD=<database password>
# PGSSLMODE=disable

# --- Server copy ---
# BACKUP_DIR=/var/backups/gesher-db
# SERVER_NAME=gesher-prod

# --- Google Drive copy (rclone remote + folder, see README step 3) ---
# RCLONE_REMOTE=gdrive:Gesher-DB-Backups
# RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# SKIP_DRIVE=1            # only for testing the server copy

# Optional: encrypt the Google Drive copy (the server copy stays plain).
# Keep the passphrase somewhere safe too - without it the Drive copy cannot
# be restored.
# BACKUP_GPG_PASSPHRASE_FILE=/etc/gesher/backup-passphrase

# --- Retention in days (server and Drive) ---
# Default: the last 10 days only; a backup is deleted once it is 10 days old.
# KEEP_DAILY_DAYS=10
# Extra long-term copies are off (0). E.g. 28 / 365 to also keep Sunday's
# backup for 4 weeks and the 1st-of-month backup for a year.
# KEEP_WEEKLY_DAYS=0
# KEEP_MONTHLY_DAYS=0

# --- Alerts (default: from the app .env, see top) ---
# More than one: separate with commas, e.g. ALERT_EMAIL_TO=a@x.com,b@y.com (max 50)
# ALERT_EMAIL_TO=jaimindeveloper345@gmail.com
# ALERT_EMAIL_FROM=<verified Postmark sender>
# POSTMARK_SERVER_TOKEN=<token>
# ALERT_ON_SUCCESS=1      # also email when it works

# Heartbeat: a "dead man's switch" URL (healthchecks.io / Better Stack /
# UptimeRobot heartbeat). It alerts when the backup does NOT run at all.
# HEARTBEAT_URL=

# --- Tools (only if not on PATH) ---
# pg_dump must be the same major version as the database or newer.
# PG_DUMP_BIN=/usr/lib/postgresql/17/bin/pg_dump
# PG_RESTORE_BIN=/usr/lib/postgresql/17/bin/pg_restore
# PG_DUMP_EXTRA_ARGS="--exclude-schema=example"
