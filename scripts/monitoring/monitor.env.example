# ============================================================================
# Gesher server monitor - OPTIONAL overrides
#
# You normally do NOT need this file. server-health.sh reads from the app's
# own .env (repo root, or APP_ENV_FILE=...):
#   NEXT_PUBLIC_APP_URL -> health URL = <url>/api/health
#   SMTP_USER           -> Postmark server token (when SMTP_HOST is Postmark)
#   SMTP_FROM_EMAIL     -> alert "From"
#   SUPPORT_EMAIL       -> alert "To"
#
# Only to change something, copy to /etc/gesher/monitor.env on the server
# and uncomment what you need. Values here win over the app .env.
#   sudo cp monitor.env.example /etc/gesher/monitor.env
#   sudo chmod 600 /etc/gesher/monitor.env
# ============================================================================

# APP_ENV_FILE=/path/to/partnerwithgdc/.env
# SERVER_NAME=gesher-prod

# Health URL (default: NEXT_PUBLIC_APP_URL + /api/health)
# APP_HEALTH_URL=http://localhost:3000/api/health

# Limits (percent)
# DISK_PATHS="/"          # space-separated, e.g. "/ /var/backups"
# DISK_WARN_PCT=80
# MEM_WARN_PCT=90
# CPU_WARN_PCT=90         # 5-minute load average as % of CPU cores

# DB backup freshness (file written by scripts/backup/db-backup.sh)
# BACKUP_STATUS_FILE=/var/backups/gesher-db/last-success.txt
# BACKUP_MAX_AGE_HOURS=30
# SKIP_BACKUP_CHECK=1

# Reminder while a problem lasts (hours)
# ALERT_REPEAT_HOURS=6

# Alerts (default: from the app .env, see top)
# More than one: separate with commas, e.g. ALERT_EMAIL_TO=a@x.com,b@y.com (max 50)
# ALERT_EMAIL_TO=jaimindeveloper345@gmail.com
# ALERT_EMAIL_FROM=<verified Postmark sender>
# POSTMARK_SERVER_TOKEN=<token>

# Optional: heartbeat URL (healthchecks.io etc., period 5 min) - alerts if
# this monitor itself stops running
# HEARTBEAT_URL=

# STATE_DIR=/var/lib/gesher-monitor
