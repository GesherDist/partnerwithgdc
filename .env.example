# ==============================================
# GESHER DISTRIBUTION - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
# ==============================================

# ----------------------------------------------
# APPLICATION
# ----------------------------------------------
NEXT_PUBLIC_APP_NAME="Gesher Distribution"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ----------------------------------------------
# SUPABASE
# ----------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (DO NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ----------------------------------------------
# DATABASE
# ----------------------------------------------
# Get the connection string from Supabase Dashboard > Settings > Database
#
# IMPORTANT: For best performance, use the POOLER connection (port 6543):
# - Transaction mode pooler is recommended for serverless/Next.js apps
# - Direct connection (port 5432) causes slow SSL handshakes on each request
#
# Pooler URL format (RECOMMENDED for app):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (for migrations only - NOT for app queries):
# Use this ONLY for running migrations with drizzle-kit or similar tools
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ----------------------------------------------
# AUTHENTICATION
# ----------------------------------------------
# Session configuration
AUTH_SESSION_DURATION=86400
AUTH_REFRESH_THRESHOLD=3600

# ----------------------------------------------
# QUICKBOOKS ONLINE INTEGRATION
# ----------------------------------------------
# Get these from: https://developer.intuit.com/app/developer/dashboard
# 1. Create an app in the Intuit Developer Portal
# 2. Go to Keys & OAuth > Development/Production settings
# 3. Copy Client ID and Client Secret
# 4. Set redirect URI to: http://localhost:3000/api/quickbooks/callback

# OAuth credentials
NEXT_QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
NEXT_QUICKBOOKS_SECRET_ID=your_quickbooks_client_secret
NEXT_QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback

# Environment: 'sandbox' or 'production'
NEXT_QUICKBOOKS_ENVIRONMENT=sandbox

# Webhook verifier token (Intuit developer portal > app > Webhooks).
# Webhook URL: https://<your-domain>/api/webhooks/quickbooks, event: Invoice (Create)
QBO_WEBHOOK_VERIFIER_TOKEN=your_webhook_verifier_token

# Encryption key for storing tokens (32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QBO_ENCRYPTION_KEY=your_64_hex_char_encryption_key

# ----------------------------------------------
# PIPEDRIVE CRM INTEGRATION (OAuth 2.0)
# ----------------------------------------------
# Get these from: https://developers.pipedrive.com/docs/api/v1
# 1. Go to Developer Hub: https://app.pipedrive.com/settings/developer-hub
# 2. Create a new app (choose "Create public app" for OAuth)
# 3. Copy Client ID and Client Secret from app settings
# 4. Add callback URL in "OAuth & Access Scopes" section:
#    - Development: http://localhost:3000/api/pipedrive/callback
#    - Production: https://your-domain.com/api/pipedrive/callback
# 5. Enable required scopes: base, contacts:full, deals:full, activities:full, organizations:full

# OAuth credentials
PIPEDRIVE_CLIENT_ID=your_pipedrive_client_id
PIPEDRIVE_CLIENT_SECRET=your_pipedrive_client_secret

# Callback URL (must match exactly what's registered in Pipedrive)
PIPEDRIVE_REDIRECT_URI=http://localhost:3000/api/pipedrive/callback

# Encryption key for storing tokens (use same as QBO or generate new)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Pipedrive webhooks (HTTP Basic Auth - Pipedrive does not sign payloads).
# REQUIRED: without a password every webhook request is rejected, so deals,
# notes, activities and organizations stop syncing into Gesher.
# Register the webhook in Pipedrive with these credentials and the URL:
#   https://<your-domain>/api/webhooks/pipedrive
# Events needed: deal, person, note, activity, organization (added/updated/deleted)
PIPEDRIVE_WEBHOOK_USERNAME=gesher
PIPEDRIVE_WEBHOOK_PASSWORD=your_webhook_basic_auth_password

# Company time zone (IANA name) for the Pipedrive daily digest, call-report
# due dates and the monthly rep report month boundaries.
# Defaults to UTC when unset, which shifts "today" and month cut-offs.
GDC_TIMEZONE=America/New_York

# ----------------------------------------------
# EMAIL / SMTP
# ----------------------------------------------
# Used by: pick ticket emails, purchase order emails to suppliers,
# platinum dealer allocation emails, the Pipedrive daily rep digest,
# and the Help & Support widget.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=accounting@example.com
SMTP_FROM_NAME="Gesher Distribution"

# ----------------------------------------------
# INBOUND EMAIL (Postmark)
# ----------------------------------------------
# Inbound addresses routed by the local part of the recipient:
#   shipping@  -> Seaair shipment tracking processor
#   customer@  -> Customer PO extraction + matching
#   supplier@  -> Supplier PO confirmation
#   freight@   -> Generic freight update
# Webhook URL: https://<your-domain>/api/webhooks/postmark/inbound
#
# Optional shared secret. When set, Postmark must call the webhook with
# ?token=<value>. LEAVE UNSET AND THE ENDPOINT ACCEPTS ANY REQUEST -
# set it in production so nobody can post fake emails into the system.
POSTMARK_INBOUND_TOKEN=your_inbound_webhook_token

# ----------------------------------------------
# AI EXTRACTION (OpenAI)
# ----------------------------------------------
# Used by: customer PO PDF extraction (GPT-4o Vision), Seaair shipping email
# extraction, and the customer/supplier/freight email parsers.
# Without it those features fall back to regex or stop extracting.
OPENAI_API_KEY=your_openai_api_key

# ----------------------------------------------
# CONTAINER TRACKING (CMA CGM)
# ----------------------------------------------
# Track & Trace API key from https://api-portal.cma-cgm.com
# Used by the daily cron /api/cron/cma-cgm-sync and the manual
# /api/shipping/track endpoint. Container tracking is skipped when unset.
CMA_CGM_API_KEY=your_cma_cgm_api_key

# ----------------------------------------------
# SCHEDULED JOBS (CRON)
# ----------------------------------------------
# Shared secret for the cron endpoints. Every cron route FAILS CLOSED:
# without this value each request is rejected and nothing runs.
# The scheduler must send: Authorization: Bearer <CRON_SECRET>
# Jobs: /api/cron/cma-cgm-sync (06:00 UTC daily)
#       /api/cron/quickbooks-financials (11:30 UTC daily)
#       /api/cron/pipedrive-reconcile (13:15 UTC daily)
#       /api/cron/pipedrive-daily-digest (12:00 UTC Mon-Fri)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_cron_shared_secret

# ----------------------------------------------
# AWS S3 STORAGE
# ----------------------------------------------
# Get these from: https://console.aws.amazon.com/iam/
# 1. Create an IAM user with S3 access
# 2. Attach policy: AmazonS3FullAccess (or create custom policy)
# 3. Generate Access Keys from Security Credentials tab
# 4. Create S3 bucket in your preferred region
# 5. Configure CORS if browser uploads are needed

# S3 Bucket name (must be globally unique)
AWS_S3_BUCKET=gesher-documents

# AWS Region (where your S3 bucket is located)
# Common regions: us-east-1, us-west-2, eu-west-1, ap-south-1
AWS_REGION=us-east-1

# IAM Access Keys (KEEP THESE SECRET!)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Help & Support widget: messages are emailed here (via the SMTP settings);
# attachments are stored in AWS_S3_BUCKET under support-requests/
SUPPORT_EMAIL=support@example.com

# Optional: CloudFront CDN domain (for faster file delivery)
# AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# ----------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
